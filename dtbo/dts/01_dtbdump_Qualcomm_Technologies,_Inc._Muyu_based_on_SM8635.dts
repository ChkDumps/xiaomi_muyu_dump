	fragment@107 {
		target = <0xffffffff>;

		__overlay__ {

			pmx_sde {
				phandle = <0x1a8>;

				sde_dsi_active {
					phandle = <0x180>;

					mux {
						function = "gpio";
						pins = "gpio2";
					};

					config {
						bias-disable = <0x00>;
						drive-strength = <0x08>;
						pins = "gpio2";
					};
				};

				sde_dsi_suspend {
					phandle = <0x182>;

					mux {
						function = "gpio";
						pins = "gpio2";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio2";
					};
				};

				sde_dsi1_active {
					phandle = <0x187>;

					mux {
						function = "gpio";
						pins = "gpio54";
					};

					config {
						bias-disable = <0x00>;
						drive-strength = <0x08>;
						pins = "gpio54";
					};
				};

				sde_dsi1_suspend {
					phandle = <0x189>;

					mux {
						function = "gpio";
						pins = "gpio54";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio54";
					};
				};
			};

			pmx_sde_te {
				phandle = <0x1a9>;

				sde_te_active {
					phandle = <0x181>;

					mux {
						function = "mdp_vsync_p";
						pins = "gpio77";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio77";
					};
				};

				sde_te_suspend {
					phandle = <0x183>;

					mux {
						function = "mdp_vsync_p";
						pins = "gpio77";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio77";
					};
				};

				sde_te1_active {
					phandle = <0x188>;

					mux {
						function = "mdp_vsync_s";
						pins = "gpio78";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio78";
					};
				};

				sde_te1_suspend {
					phandle = <0x18a>;

					mux {
						function = "mdp_vsync_s";
						pins = "gpio78";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio78";
					};
				};
			};
		};
	};

