/dts-v1/;

/ {
	qcom,pmic-id-size = <0x08>;
	qcom,pmic-id = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x4c>;
	model = "Qualcomm Technologies, Inc. Muyu based on SM8635";
	compatible = "qcom,cliffs-mtp", "qcom,cliffs", "qcom,mtp";
	qcom,msm-id = <0x282 0x10000 0x278 0x10000 0x283 0x10000 0x266 0x10000>;
	qcom,board-id = <0x08 0x00>;
	xiaomi,miboard-id = <0x0a 0x00>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			ntag {

				ntag_int_default {
					phandle = <0x3a>;

					mux {
						pins = "gpio170";
						function = "gpio";
					};

					config {
						pins = "gpio170";
						drive-strength = <0x02>;
						bias-pull-up;
					};
				};

				ntag_int_suspend {
					phandle = <0x3b>;

					mux {
						pins = "gpio170";
						function = "gpio";
					};

					config {
						pins = "gpio170";
						drive-strength = <0x02>;
						bias-pull-up;
					};
				};
			};

			wifi_ctrl_irq {
				phandle = <0x39>;

				mux {
					pins = "gpio135";
					function = "gpio";
				};

				config {
					pins = "gpio135";
					drive-strength = <0x02>;
					bias-disable;
					input-enable;
				};
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			fingerprint_fpc {
				status = "ok";
				compatible = "fpc,fpc1020";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x75 0x00>;
				fpc,gpio_rst = <0xffffffff 0x37 0x00>;
				fpc,gpio_irq = <0xffffffff 0x75 0x00>;
				fp_vdd_vreg-supply = <0xffffffff>;
				pinctrl-names = "fpc1020_reset_reset", "fpc1020_reset_active", "fpc1020_irq_active";
				pinctrl-0 = <0x01>;
				pinctrl-1 = <0x02>;
				pinctrl-2 = <0x03>;
			};

			xiaomi_fingerprint {
				compatible = "xiaomi-fingerprint";
				status = "ok";
				fingerprint,name = "xiaomi-fingerprint";
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			regulator-min-microvolt = <0x325aa0>;
			regulator-max-microvolt = <0x325aa0>;
			qcom,init-voltage = <0x325aa0>;
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {

			msm_gpio_reset {
				phandle = <0x01>;

				mux {
					pins = "gpio55";
					function = "gpio";
				};

				config {
					pins = "gpio55";
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};
			};

			msm_gpio_reset_output_high {
				phandle = <0x02>;

				mux {
					pins = "gpio55";
					function = "gpio";
				};

				config {
					pins = "gpio55";
					drive-strength = <0x02>;
					bias-disable;
					output-high;
				};
			};

			msm_gpio_irq {
				phandle = <0x03>;

				mux {
					pins = "gpio117";
					function = "gpio";
				};

				config {
					pins = "gpio117";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pmk8550@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x46>;

					smb1510_present@5d {
						reg = <0x5d 0x01>;
						bits = <0x05 0x05>;
						phandle = <0x2d>;
					};

					ocp-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x1b>;
					};

					ufs_dev@ad {
						reg = <0xaf 0x01>;
						bits = <0x00 0x00>;
						phandle = <0x47>;
					};
				};

				sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x48>;

					restart@48 {
						reg = <0x48 0x01>;
						bits = <0x01 0x07>;
						phandle = <0x18>;
					};

					wr_thermal-flag@58 {
						reg = <0x58 0x01>;
						phandle = <0x49>;
					};

					alarm-log@76 {
						reg = <0x76 0x06>;
						phandle = <0x4a>;
					};
				};

				sdam@7400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7400>;
					phandle = <0x19>;
				};

				sdam@7500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7500>;
					phandle = <0x1a>;
				};

				sdam@7c00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7c00>;
					phandle = <0x2a>;
				};

				sdam@7d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7d00>;
					phandle = <0x2b>;
				};

				sdam@8400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8400>;
					phandle = <0x0b>;
				};

				sdam@8500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8500>;
					phandle = <0x0c>;
				};

				sdam@9800 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9800>;
					phandle = <0x2c>;
				};

				sdam@9a00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9a00>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x4b>;

					sqm-timer@b8 {
						reg = <0xb8 0x02>;
						phandle = <0x4c>;
					};
				};

				sdam@9d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9d00>;
					phandle = <0x4d>;
				};

				sdam@a000 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa000>;
					phandle = <0x4e>;
				};

				sdam@a400 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa400>;
					phandle = <0x4f>;
				};

				sdam@b600 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb600>;
					phandle = <0x50>;

					usb-mode@50 {
						reg = <0x50 0x01>;
						phandle = <0x51>;
					};
				};

				pon_hlos@1300 {
					compatible = "qcom,pm8998-pon";
					reg = <0x1300 0x800>;
					reg-names = "pon_hlos", "pon_pbs";

					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x00 0x13 0x07 0x03>;
						linux,code = <0x74>;
						phandle = <0x52>;
					};

					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x72>;
					};

					pwrkey-resin-bark {
						compatible = "qcom,pmk8350-pwrkey-resin-bark";
						interrupts = <0x00 0x13 0x02 0x03>;
						linux,code = <0x74>;
					};

					pwrkey-bark {
						compatible = "qcom,pmk8350-pwrkey-bark";
						interrupts = <0x00 0x13 0x00 0x03>;
						linux,code = <0x74>;
					};
				};

				pinctrl@b800 {
					compatible = "qcom,pmk8550-gpio";
					reg = <0xb800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <0x04>;
					pinctrl-names = "default";
					phandle = <0x53>;

					alt_sleep_clk {

						alt_sleep_clk_default {
							pins = "gpio3";
							function = "func1";
							input-disable;
							output-enable;
							bias-disable;
							power-source = <0x00>;
							phandle = <0x04>;
						};
					};
				};

				qcom,pwms@e800 {
					status = "disabled";
					compatible = "qcom,pwm-lpg";
					reg = <0xe800>;
					reg-names = "lpg-base";
					qcom,num-lpg-channels = <0x01>;
					#pwm-cells = <0x02>;
					phandle = <0x54>;
				};

				qcom,pwms@e900 {
					status = "disabled";
					compatible = "qcom,pwm-lpg";
					reg = <0xe900>;
					reg-names = "lpg-base";
					qcom,num-lpg-channels = <0x01>;
					#pwm-cells = <0x02>;
					phandle = <0x55>;
				};

				rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = <0x6100 0x6200>;
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x62 0x01 0x01>;
					phandle = <0x56>;
				};

				vadc@9000 {
					compatible = "qcom,spmi-adc5-gen3";
					reg = <0x9000 0x9100>;
					qcom,debug-base = <0x7600>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupt-names = "adc-sdam0", "adc-sdam1";
					interrupts = <0x00 0x90 0x01 0x01 0x00 0x91 0x01 0x01>;
					#thermal-sensor-cells = <0x01>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-names = "default";
					pinctrl-0 = <0x05 0x06 0x07 0x08 0x09>;
					phandle = <0x0a>;

					pmk8550_offset_ref {
						reg = <0x00>;
						label = "pmk8550_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_vref_1p25 {
						reg = <0x01>;
						label = "pmk8550_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_die_temp {
						reg = <0x03>;
						label = "pmk8550_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8550_xo_therm {
						reg = <0x44>;
						label = "pmk8550_xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm8550vs_c_die_temp {
						reg = <0x203>;
						label = "pm8550vs_c_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8550ve_die_temp {
						reg = <0x303>;
						label = "pm8550ve_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmxr2230_offset_ref {
						reg = <0x100>;
						label = "pmxr2230_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmxr2230_vref_1p25 {
						reg = <0x101>;
						label = "pmxr2230_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmxr2230_die_temp {
						reg = <0x103>;
						label = "pmxr2230_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmxr2230_vph_pwr {
						reg = <0x18e>;
						label = "pmxr2230_vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pm7550ba_offset_ref {
						reg = <0x700>;
						label = "pm7550ba_offset_ref";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm7550ba_vref_1p25 {
						reg = <0x701>;
						label = "pm7550ba_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm7550ba_die_temp {
						reg = <0x703>;
						label = "pm7550ba_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm7550ba_vph_pwr {
						reg = <0x78e>;
						label = "pm7550ba_vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pm7550ba_chg_temp {
						reg = <0x710>;
						label = "pm7550ba_chg_temp";
					};

					pm7550ba_iin_fb {
						reg = <0x717>;
						label = "pm7550ba_iin_fb";
					};

					pm7550ba_ichg_fb {
						reg = <0x7a1>;
						label = "pm7550ba_ichg_fb";
					};

					pm7550ba_batt_therm {
						reg = <0x744>;
						label = "pm7550ba_batt_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,scale-fn-type = <0x17>;
					};

					pmxr2230_ap_therm {
						reg = <0x145>;
						label = "pmxr2230_ap_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pmxr2230_quiet_therm {
						reg = <0x147>;
						label = "pmxr2230_quiet_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pmxr2230_flash_therm {
						reg = <0x148>;
						label = "pmxr2230_flash_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pmxr2230_display_therm {
						reg = <0x14c>;
						label = "pmxr2230_display_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pmxr2230_conn_therm2 {
						reg = <0x14d>;
						label = "pmxr2230_conn_therm2";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm7550ba_backlight_therm {
						reg = <0x74b>;
						label = "pm7550ba_backlight_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm7550ba_wifi_therm {
						reg = <0x74c>;
						label = "pm7550ba_wifi_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm7550ba_charger_therm {
						reg = <0x749>;
						label = "pm7550ba_charger_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};

					pm7550ba_conn_therm {
						reg = <0x747>;
						label = "pm7550ba_conn_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,adc-tm-type = <0x01>;
					};
				};
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pmxr2230@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmxr2230-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x01 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x0a 0x103>;
					io-channel-names = "thermal";
					phandle = <0x0e>;
				};

				pinctrl@8800 {
					compatible = "qcom,pmxr2230-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x29>;

					key_vol_up {

						key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x28>;
						};
					};

					sys_therm_2_gpio7 {

						sys_therm_2_gpio7_default {
							pins = "gpio7";
							bias-high-impedance;
							phandle = <0x57>;
						};
					};

					sys_therm_8_gpio10 {

						sys_therm_8_gpio10_default {
							pins = "gpio10";
							bias-high-impedance;
							phandle = <0x58>;
						};
					};

					display_therm {

						display_therm_default {
							pins = "gpio7";
							bias-high-impedance;
							phandle = <0x08>;
						};
					};

					conn_therm2 {

						conn_therm2_default {
							pins = "gpio10";
							bias-high-impedance;
							phandle = <0x09>;
						};
					};
				};

				pwms@e800 {
					compatible = "qcom,pwm-lpg";
					reg = <0xe800>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x03>;
					nvmem = <0x0b 0x0c>;
					nvmem-names = "lpg_chan_sdam", "lut_sdam";
					qcom,lut-sdam-base = <0x45>;
					qcom,lut-patterns = <0x00 0x0a 0x14 0x1e 0x28 0x32 0x3c 0x46 0x50 0x5a 0x64 0x5a 0x50 0x46 0x3c 0x32 0x28 0x1e 0x14 0x0a 0x00>;
					qcom,tick-duration-us = <0x1e78>;
					phandle = <0x0d>;

					lpg@1 {
						qcom,lpg-chan-id = <0x01>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x48>;
					};

					lpg@2 {
						qcom,lpg-chan-id = <0x02>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x56>;
					};

					lpg@3 {
						qcom,lpg-chan-id = <0x03>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x64>;
					};
				};

				pwms@e900 {
					compatible = "qcom,pwm-lpg";
					reg = <0xe900>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x01>;
					phandle = <0x59>;
				};

				pwms@eb00 {
					compatible = "qcom,pwm-lpg";
					reg = <0xeb00>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x01>;
					phandle = <0x5a>;
				};

				qcom,leds@ef00 {
					compatible = "qcom,tri-led";
					reg = <0xef00>;
					phandle = <0x5b>;

					red {
						label = "red";
						pwms = <0x0d 0x00 0xf4240>;
						led-sources = <0x00>;
						linux,default-trigger = "timer";
					};

					green {
						label = "green";
						pwms = <0x0d 0x01 0xf4240>;
						led-sources = <0x01>;
						linux,default-trigger = "timer";
					};

					blue {
						label = "blue";
						pwms = <0x0d 0x02 0xf4240>;
						led-sources = <0x02>;
						linux,default-trigger = "timer";
					};
				};

				qcom,flash_led@ee00 {
					compatible = "qcom,pm8350c-flash-led";
					reg = <0xee00>;
					interrupts = <0x01 0xee 0x00 0x01 0x01 0xee 0x03 0x01 0x01 0xee 0x04 0x01>;
