        <ctl name="aw_dev_1_prof"  value="Music" />
        <ctl name="aw_dev_2_switch" value="Enable" />
        <ctl name="aw_dev_2_prof"  value="Music" />
        <ctl name="aw_dev_3_switch" value="Enable" />
        <ctl name="aw_dev_3_prof"  value="Music" />
    </path>

    <path name="speaker-mono">
